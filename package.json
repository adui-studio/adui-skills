{
  "name": "@adui-studio/adui-skills",
  "version": "0.2.0",
  "private": true,
  "description": "ADui 的全栈、跨端、3D/GPU 与 Git Agent Skills 精选、路由和维护体系。",
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate-registry.mjs",
    "validate:registry": "node scripts/validate-registry.mjs",
    "detect:stack": "node skills/adui-stack-router/scripts/detect-stack.mjs",
    "lock:init": "node scripts/check-updates.mjs --write --prune --report tmp/skill-updates.md",
    "updates:check": "node scripts/check-updates.mjs --report tmp/skill-updates.md",
    "updates:apply": "node scripts/check-updates.mjs --write --prune --report tmp/skill-updates.md",
    "test": "node --test scripts/tests/*.test.mjs",
    "test:updates": "node --test scripts/tests/check-updates.test.mjs",
    "test:router": "node --test scripts/tests/stack-router.test.mjs",
    "profile:list": "node scripts/profile-manager.mjs list",
    "profile:show": "node scripts/profile-manager.mjs show",
    "profile:plan": "node scripts/profile-manager.mjs plan",
    "profile:install": "node scripts/profile-manager.mjs install",
    "profile:auto-install": "node scripts/profile-manager.mjs auto-install",
    "test:profiles": "node --test scripts/tests/profile-manager.test.mjs scripts/tests/package-manager.test.mjs",
    "wiki:build": "node scripts/build-wiki.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:package": "node scripts/build-release.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
