{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADui Skills Registry",
  "type": "object",
  "required": [
    "version",
    "skills"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "updatedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "category",
          "tier",
          "enabled"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "upstreamPath": {
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "enum": [
              "S+",
              "S",
              "A+",
              "A",
              "B"
            ]
          },
          "official": {
            "type": "boolean"
          },
          "enabled": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}